eir identity.","story_url":"https://en.wikipedia.org/wiki/Saint_Piran%27s_Flag"},{"id":"q23103","q":"Q23103","name":"Shropshire","region":"West Midlands","country":"United Kingdom","kind":"division","type":"Ceremonial county","lat":52.6167,"lon":-2.7167,"pop":506737,"about":"Ceremonial county in the United Kingdom","wiki":"https://en.wikipedia.org/wiki/Shropshire","img":"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bb/Flag_of_Shropshire.svg/330px-Flag_of_Shropshire.svg.png","src":"https://commons.wikimedia.org/wiki/Special:FilePath/Flag_of_Shropshire.svg?width=960","credit":{"artist":"Hogweard","license":"CC BY-SA 3.0","url":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Shropshire.svg"}},{"id":"q23066","q":"Q23066","name":"Cumbria","region":"North West England","country":"United Kingdom","kind":"division","type":"Ceremonial county","lat":54.5,"lon":-3.25,"pop":499781,"about":"Ceremonial county of England","wiki":"https://en.wikipedia.org/wiki/Cumbria","img":"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a0/Flag_of_Cumbria_County_Council.svg/330px-Flag_of_Cumbria_County_Council.svg.png","src":"https://commons.wikimedia.org/wiki/Special:FilePath/Flag_of_Cumbria_County_Council.svg?width=960","credit":{"artist":"Original: Ipankonin Vector: Jza84 + Tudor rose.svg : Ipankonin File:Meuble héraldique quin","license":"CC BY-SA 3.0","url":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Cumbria_County_Council.svg"}},{"id":"q23079","q":"Q23079","name":"Northumberland","region":"North East England","country":"United Kingdom","kind":"division","type":"Unitary authority area","lat":55.1667,"lon":-2.0,"pop":323820,"about":"Ceremonial county and unitary authority area in north east England, UK","wiki":"https://en.wikipedia.org/wiki/Northumberland","img":"https://upload.wikimedia.org/wikipedia/commons/thumb/6/61/Flag_of_Northumberland.svg/330px-Flag_o