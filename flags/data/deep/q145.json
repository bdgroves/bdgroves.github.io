i":"https://en.wikipedia.org/wiki/Ceredigion","img":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4e/Flag_of_Ceredigion.svg/330px-Flag_of_Ceredigion.svg.png","src":"https://commons.wikimedia.org/wiki/Special:FilePath/Flag_of_Ceredigion.svg?width=960","credit":{"artist":"AlexD","license":"CC BY-SA 3.0","url":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Ceredigion.svg"}},{"id":"q23107","q":"Q23107","name":"Rutland","region":"East Midlands","country":"United Kingdom","kind":"division","type":"Unitary authority area","lat":52.65,"lon":-0.6333,"pop":41151,"about":"County and unitary authority area in the East Midlands in England, United Kingdom","wiki":"https://en.wikipedia.org/wiki/Rutland","img":"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1a/Rutland_County_Flag.svg/330px-Rutland_County_Flag.svg.png","src":"https://commons.wikimedia.org/wiki/Special:FilePath/Rutland_County_Flag.svg?width=960","credit":{"artist":"Hogweard","license":"Public domain","url":null,"page":"https://commons.wikimedia.org/wiki/File:Rutland_County_Flag.svg"}},{"id":"q80967","q":"Q80967","name":"Outer Hebrides","region":"Scotland","country":"United Kingdom","kind":"division","type":"Council area","lat":57.76,"lon":-7.02,"pop":26720,"about":"Archipelago and council area off the west coast of mainland Scotland","wiki":"https://en.wikipedia.org/wiki/Outer_Hebrides","img":"https://upload.wikimedia.org/wikipedia/commons/thumb/0/03/Western_Isles_Council_Flag.svg/330px-Western_Isles_Council_Flag.svg.png","src":"https://commons.wikimedia.org/wiki/Special:FilePath/Western_Isles_Council_Flag.svg?width=960","credit":{"artist":"Leonardo Piccioni de Almeida","license":"CC BY-SA 3.0","url":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Western_Isles_Council_Flag.svg"}},{"id":"q47134","q":"Q47134","name":"Shetland Islands","region":"Scotland","country":"United Kingdom","kind":"division","type":"Council area","lat":60.3567,"lon":-1.2606,"pop":23210,"about":"Subarctic archipelago, county and council area of Scotland that lies north-east of mainland Britain","wiki":"https://en.wikipedia.org/wiki/Shetland","img":"https://upload.wikimedia.org/wikipedia/commons/thumb/0/0a/Flag_of_Shetland.svg/330px-Flag_of_Shetland.svg.png","src":"https://commons.wikimedia.org/wiki/Special:FilePath/Flag_of_Shetland.svg?width=960","credit":{"artist":null,"license":"Public domain","url":null,"page":"https://commons.wikimedia.org/wiki/File:Flag_of_Shetland.svg"},"story":"The flag of Shetland is a white or silver Nordic cross on a blue background. The flag uses the colours of the flag of Scotland, but in the form of the Nordic cross in order to symbolise Shetland's historical and cultural ties with Scandinavia.","story_url":"https://en.wikipedia.org/wiki/Flag_of_Shetland"},{"id":"q100166","q":"Q100166","name":"Orkney Islands","region":"Scotland","country":"United Kingdom","kind":"division","type":"Council area","lat":59.0,"lon":-3.0,"pop":22270,"about":"Archipelago, county and council area in northern Scotland","wiki":"https://en.wikipedia.org/wiki/Orkney","img":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/42/2007_Flag_of_Orkney.svg/330px-2007_Flag_of_Orkney.svg.png","src":"https://commons.wikimedia.org/wiki/Special:FilePath/2007_Flag_of_Orkney.svg?width=960","credit":{"artist":"Rab Knight from en.wikipedia","license":"Public domain","url":null,"page":"https://commons.wikimedia.org/wiki/File:2007_Flag_of_Orkney.svg"},"story":"The Flag of Orkney was the winner of a public flag consultation in February and March 2007. In the flag consultation the people of Orkney were asked for their preferred design from a short list of 5, all of which had been approved by the Court of the Lord Lyon.","story_url":"https://en.wikipedia.org/wiki/Flag_of_Orkney"},{"id":"q23311","q":"Q23311","name":"City of London","region":"London","country":"United Kingdom","kind":"division","type":"Ceremonial county","lat":51.5156,"lon":-0.0931,"pop":8583,"about":"Central business district of London, England","wiki":"https://en.wikipedia.org/wiki/City_of_London","img":"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c7/Flag_of_the_City_of_London.svg/330px-Flag_of_the_City_of_London.svg.png","src":"https://commons.wikimedia.org/wiki/Special:FilePath/Flag_of_the_City_of_London.svg?width=960","credit":{"artist":"Greentubing","license":"Public domain","url":null,"page":"https://commons.wikimedia.org/wiki/File:Flag_of_the_City_of_London.svg"},"story":"The flag of the City of London is based on the flag of England, having a centred red St George's Cross on a white background, with the red sword in the upper hoist canton. The sword is believed to represent the sword that beheaded Saint Paul, who is the patron saint of the city.","story_url":"https://en.wikipedia.org/wiki/Flag_of_the_City_of_London"},{"id":"q180209","q":"Q180209","name":"Isles of Scilly","region":"Cornwall","country":"United Kingdom","kind":"division","type":"Unitary authority area","lat":49.92,"lon":-6.3,"pop":2281,"about":"Archipelago and local government district off the south-westernmost point of mainland Britain","wiki":"https://en.wikipedia.org/wiki/Isles_of_Scilly","img":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/21/ScillonianCross.svg/330px-ScillonianCross.svg.png","src":"https://commons.wikimedia.org/wiki/Special:FilePath/ScillonianCross.svg?width=960","credit":{"artist":"Steve Duncan","license":"CC BY 2.5","url":"https://creativecommons.org/licenses/by/2.5","page":"https://commons.wikimedia.org/wiki/File:ScillonianCross.svg"},"story":"The Scillonian Cross is a unitary authority flag created in 2002 for the Isles of Scilly, United Kingdom. The flag was designed by the Scilly News, and received positive support from its readers in a popular vote, leading to it being officially registered with the Flag Institute as the official flag for the islands.","story_url":"https://en.wikipedia.org/wiki/Scillonian_Cross"}]}